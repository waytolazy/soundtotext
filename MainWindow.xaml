<Window x:Class="SoundToText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundToText"
        Width="408" Height="106"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Storyboard x:Key="WaveLoop" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar0" Storyboard.TargetProperty="Height">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="6"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="22"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="6"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="6"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar1" Storyboard.TargetProperty="Height">
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="6"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="26"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="6"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="6"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar2" Storyboard.TargetProperty="Height">
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="6"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="30"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="6"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="6"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar3" Storyboard.TargetProperty="Height">
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="6"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="26"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="6"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="6"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar4" Storyboard.TargetProperty="Height">
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="6"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="22"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="6"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="6"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="GlassRoot" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="GlassRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.94" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="GlassRoot"
            CornerRadius="22"
            BorderBrush="{StaticResource GlassStroke}"
            BorderThickness="1"
            RenderTransformOrigin="0.5,1"
            Margin="14"
            MouseLeftButtonDown="OnDragStart">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F50A0A0C" Offset="0"/>
                <GradientStop Color="#F5020203" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="68" Margin="14,0,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle x:Name="Bar0" Width="4" Height="6" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}"/>
                    <Rectangle x:Name="Bar1" Width="4" Height="10" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}"/>
                    <Rectangle x:Name="Bar2" Width="4" Height="14" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}"/>
                    <Rectangle x:Name="Bar3" Width="4" Height="10" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}"/>
                    <Rectangle x:Name="Bar4" Width="4" Height="6" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                <TextBlock x:Name="TitleText" Text="SoundToText"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable, Segoe UI"/>
                <TextBlock x:Name="StatusText" Text="Ready"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11" Margin="0,2,8,0"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="Segoe UI Variable, Segoe UI"/>
            </StackPanel>

            <Button Grid.Column="2" Content="✕"
                    Width="26" Height="26" Margin="0,0,12,0"
                    Background="Transparent"
                    Foreground="{StaticResource MutedBrush}"
                    BorderThickness="0"
                    FontSize="11"
                    Cursor="Hand"
                    Click="OnHideClick"
                    ToolTip="Hide (stays in tray)"/>
        </Grid>
    </Border>
</Window>
