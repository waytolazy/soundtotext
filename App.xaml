<Application x:Class="SoundToText.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AccentColor">#4FB1FF</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="GlassFill" Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="GlassStroke" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="TextBrush" Color="#F2FFFFFF"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#99FFFFFF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
