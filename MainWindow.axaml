<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SoundToText.MainWindow"
        Title="SoundToText"
        Icon="avares://SoundToText/Assets/appicon.png"
        Width="408" Height="106"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        CanResize="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <Border x:Name="GlassRoot"
            CornerRadius="22"
            BorderBrush="{StaticResource GlassStroke}"
            BorderThickness="1"
            RenderTransformOrigin="50%,100%"
            Margin="14"
            BoxShadow="0 0 14 0 #73000000"
            PointerPressed="OnDragStart">
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#F50A0A0C" Offset="0"/>
                <GradientStop Color="#F5020203" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="68" Margin="14,0,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle x:Name="Bar0" Width="4" Height="6" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}"/>
                    <Rectangle x:Name="Bar1" Width="4" Height="10" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}"/>
                    <Rectangle x:Name="Bar2" Width="4" Height="14" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}"/>
                    <Rectangle x:Name="Bar3" Width="4" Height="10" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}"/>
                    <Rectangle x:Name="Bar4" Width="4" Height="6" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                <TextBlock x:Name="TitleText" Text="SoundToText"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="Ready"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11" Margin="0,2,8,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button Grid.Column="2" Content="✕"
                    Width="26" Height="26" Margin="0,0,12,0"
                    Background="Transparent"
                    Foreground="{StaticResource MutedBrush}"
                    BorderThickness="0"
                    FontSize="11"
                    Cursor="Hand"
                    Click="OnHideClick"
                    ToolTip.Tip="Hide (stays in tray)"/>
        </Grid>
    </Border>
</Window>
