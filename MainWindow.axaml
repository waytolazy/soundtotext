<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SoundToText.MainWindow"
        Title="SoundToText"
        Icon="avares://SoundToText/Assets/appicon.png"
        Width="408" Height="106"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        CanResize="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <Window.Styles>
        <Style Selector="Button.HudClose">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.HudClose:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.18)"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.HudClose:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)"/>
        </Style>
        <Style Selector="Button.HudClose /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.HudClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Border x:Name="GlassRoot"
                CornerRadius="22"
                BorderBrush="{StaticResource GlassStroke}"
                BorderThickness="1"
                RenderTransformOrigin="50%,50%"
                Margin="14"
                BoxShadow="0 0 14 0 #73000000"
                PointerPressed="OnDragStart"
                PointerEntered="OnHudPointerEntered"
                PointerExited="OnHudPointerExited">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#F50A0A0C" Offset="0"/>
                    <GradientStop Color="#F5020203" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="68" Margin="14,0,0,0" ClipToBounds="False">

                    <Ellipse x:Name="HaloLayer"
                             Width="92" Height="62"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Opacity="0"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#664FB1FF" Offset="0"/>
                                <GradientStop Color="#004FB1FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse x:Name="RippleLayer"
                             Width="20" Height="20"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                             Opacity="0"
                             RenderTransformOrigin="50%,50%"
                             IsHitTestVisible="False">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="0.4" ScaleY="0.4"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <StackPanel x:Name="BarsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle x:Name="Bar0" Width="4" Height="6" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource MutedBrush}"/>
                        <Rectangle x:Name="Bar1" Width="4" Height="10" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource MutedBrush}"/>
                        <Rectangle x:Name="Bar2" Width="4" Height="14" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource MutedBrush}"/>
                        <Rectangle x:Name="Bar3" Width="4" Height="10" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource MutedBrush}"/>
                        <Rectangle x:Name="Bar4" Width="4" Height="6" Margin="2,0" RadiusX="2" RadiusY="2" Fill="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <Border x:Name="FlashLayer"
                            Background="White"
                            CornerRadius="6"
                            Width="80" Height="40"
                            Opacity="0"
                            IsHitTestVisible="False"/>
                </Grid>

                <Grid Grid.Column="1" Margin="6,0,4,0" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="SoundToText"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <Grid Height="16">
                            <TextBlock x:Name="StatusTextA" Text="Ready"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" Margin="0,2,8,0"
                                       TextTrimming="CharacterEllipsis"
                                       Opacity="1"/>
                            <TextBlock x:Name="StatusTextB" Text=""
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" Margin="0,2,8,0"
                                       TextTrimming="CharacterEllipsis"
                                       Opacity="0"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Button Grid.Column="2" Content="✕"
                        Classes="HudClose"
                        Width="26" Height="26" Margin="0,0,12,0"
                        Background="Transparent"
                        Foreground="{StaticResource MutedBrush}"
                        BorderThickness="0"
                        FontSize="11"
                        Cursor="Hand"
                        RenderTransformOrigin="50%,50%"
                        Click="OnHideClick"
                        ToolTip.Tip="Hide (stays in tray)"/>
            </Grid>
        </Border>
    </Grid>
</Window>
